# =============================================================================
# JASpay — Variables d'environnement (exemple)
# NE JAMAIS committer de valeurs réelles. Copier ce fichier en .env localement.
# =============================================================================

# --- Frontend (Vite) — variables exposées au navigateur, préfixées VITE_ ---
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anonyme-publique

# --- Backend (Node.js) — variables réservées au serveur, NE JAMAIS exposer ---
# SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-uniquement-cote-serveur
# DATABASE_URL=postgresql://...
# JWT_SECRET=votre-secret-jwt

# --- Application ---
APP_URL=http://localhost:5173
NODE_ENV=development
